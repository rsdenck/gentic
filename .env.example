# Infraestrutura AI Agents - Configuração de Ambiente
# Copie este arquivo para .env e preencha com valores reais

# Ollama (Inferência de IA)
OLLAMA_SERVER_ADDRESS=https://api.denck.sbs
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=300

# VMware
VMWARE_VCENTER_URL=
VMWARE_USERNAME=
VMWARE_PASSWORD=
VMWARE_INSECURE=false

# Linux Agent
# (sem configurações específicas de ambiente necessárias)

# Monitoring (Graylog)
GRAYLOG_URL=
GRAYLOG_TOKEN=
GRAYLOG_TIMEOUT=

# Cloud (CloudStack)
CLOUDSTACK_URL=
CLOUDSTACK_API_KEY=
CLOUDSTACK_SECRET_KEY=
CLOUDSTACK_TIMEOUT=

# Aplicação
APP_PORT=8080
APP_ENV=development